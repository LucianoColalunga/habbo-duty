# Seguridad de la cadena de suministro:
# ninguna dependencia ejecuta scripts al instalarse (Tailwind usa binarios
# precompilados, no los necesita). `npm run build` y `npm test` funcionan igual.
ignore-scripts=true
# Al agregar dependencias, guardar la versión exacta (sin ^ ni ~).
save-exact=true
# No instalar con una versión de Node que el proyecto no soporta.
engine-strict=true
